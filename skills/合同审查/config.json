{
  "name": "合同审查",
  "version": "1.0.0",
  "description": "审查中文法律合同，以指定方视角识别风险条款、缺失条款和模糊表述，输出分级修改建议",
  "trigger_keywords": [
    "审查合同",
    "合同审查",
    "审合同",
    "修改意见",
    "法律风险",
    "check contract",
    "review agreement",
    "legal review",
    "帮我看看这个合同",
    "这份协议有什么问题",
    "合同有没有坑",
    "合同",
    "协议",
    "法律"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "contract_text": {
        "type": "string",
        "description": "合同的全文文本"
      },
      "party_role": {
        "type": "string",
        "enum": [
          "甲方",
          "乙方",
          "买方",
          "卖方",
          "出租方",
          "承租方",
          "委托方",
          "受托方",
          "实际股东",
          "名义股东"
        ],
        "description": "我方在合同中的身份"
      },
      "concerns": {
        "type": "string",
        "description": "用户特别关注的维度，如 违约金、竞业限制、管辖"
      }
    },
    "required": [
      "contract_text",
      "party_role"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "per_clause_analysis": {
        "type": "array",
        "description": "逐条分析"
      },
      "priority_matrix": {
        "type": "array",
        "description": "分级的修改清单"
      },
      "negotiation_tips": {
        "type": "array",
        "description": "谈判要点"
      }
    }
  },
  "tags": [
    "法律",
    "合规",
    "风险",
    "中文合同"
  ],
  "dependencies": [],
  "max_context_percent": 30,
