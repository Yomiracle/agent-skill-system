{
  "name": "Bug诊断与修复",
  "version": "1.0.0",
  "description": "对Python代码bug进行系统诊断：错误分类→根因定位→命中已知失效模式→生成修复→给出复测命令",
  "trigger_keywords": [
    "bug", "报错", "出错了", "跑不通", "错误", "error",
    "debug", "调试", "debugging", "故障", "排查",
    "traceback", "SyntaxError", "AttributeError", "TypeError",
    "帮我看看哪里错了", "为什么失败", "修一下"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "错误信息": {
        "type": "string",
        "description": "完整的 traceback 或错误输出"
      },
      "源代码": {
        "type": "string",
        "description": "出错文件的完整内容或相关片段"
      }
    },
    "required": ["错误信息"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "分类": { "type": "string" },
      "根因": { "type": "string" },
      "修复": { "type": "string" },
      "验证": { "type": "string" }
    }
  },
  "tags": ["开发", "调试", "Python"],
  "dependencies": [],
  "max_context_percent": 30,
  "created_at": "2026-06-11T17:00:00Z"
}
